# Demo mode — no Azure credentials required.
# Optionally override the session secret key and app URL.

# Strong random secret for session signing — generate with: openssl rand -hex 32
# Leave as-is for local demo use, override for any deployment
SECRET_KEY=demo-secret-key-not-for-production-use-abc123xyz

# App base URL (used for redirects)
APP_BASE_URL=http://localhost
